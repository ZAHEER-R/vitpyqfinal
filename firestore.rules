rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid) && request.resource.data.isAdmin == false;
      allow update: if isAdmin() ||
        (isOwner(uid) && request.resource.data.isAdmin == resource.data.isAdmin);
      allow delete: if isAdmin();
    }

    match /papers/{paperId} {
      allow read: if true;
      allow create: if signedIn();
      allow update: if signedIn() &&
        (resource.data.uploaderId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() ||
        (signedIn() && resource.data.uploaderId == request.auth.uid);
    }

    match /chats/global/messages/{msgId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow delete: if isAdmin();
    }

    match /privateChats/{chatId}/messages/{msgId} {
      allow read, create: if signedIn() &&
        request.auth.uid in chatId.split('_');
      allow delete: if isAdmin();
    }

    match /highlights/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /otps/{email} {
      allow read, write: if false; // only Cloud Functions
    }
  }
}
